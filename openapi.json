              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Minutes"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "UTC+05:30 (assumed, the portal gives none)"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "interval_minutes",
          "readings"
        ],
        "title": "EnergySeries"
      },
      "HTTPValidationError": {
        "properties": {
